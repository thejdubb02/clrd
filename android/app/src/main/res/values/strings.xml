<?xml version="1.0" encoding="utf-8"?>
<!-- Every word the app shows. Translations go in values-<lang>/strings.xml with the same names. -->
<resources>
    <string name="app_name" translatable="false">clrd</string>

    <!-- Tabs -->
    <string name="tab_inbox">Inbox</string>
    <string name="tab_snoozed">Snoozed</string>
    <string name="tab_cleared">Cleared</string>
    <string name="tab_settings">Settings</string>

    <!-- Inbox -->
    <string name="cleared_everywhere">Cleared everywhere</string>
    <string name="undo">Undo</string>
    <string name="restore">Restore</string>
    <string name="ack">Ack</string>
    <string name="snooze_for">Snooze %1$s</string>
    <string name="clear">Clear</string>
    <string name="share">Share</string>
    <string name="copy">Copy</string>
    <string name="copied">Copied</string>
    <string name="download">Download %1$s</string>
    <string name="downloading">Downloading %1$s</string>
    <string name="all_topics">All</string>
    <!-- A topic chip: the topic name and how many items it has in this tab. -->
    <string name="topic_count">%1$s  %2$d</string>
    <string name="empty_inbox">Nothing needs you.</string>
    <string name="empty_snoozed">Nothing snoozed.</string>
    <string name="empty_cleared">Nothing cleared yet.</string>
    <!-- Cleared tab, when the server holds more cleared items than the phone. %1$d is the server's count, %2$d days. -->
    <plurals name="cleared_on_server">
        <item quantity="one">%1$d cleared on the server. This phone shows the last %2$d days.</item>
        <item quantity="other">%1$d cleared on the server. This phone shows the last %2$d days.</item>
    </plurals>

    <!-- Notification states, on the chip and in the line under each one. %1$s is a device name. -->
    <string name="state_acknowledged">acknowledged</string>
    <string name="state_snoozed">snoozed</string>
    <string name="state_dismissed">dismissed</string>
    <string name="state_resolved">resolved</string>
    <string name="acked_on">acked on %1$s</string>
    <string name="cleared_on">cleared on %1$s</string>
    <string name="snoozed_until">until %1$s</string>
    <string name="unknown_device">?</string>

    <!-- How long ago, kept short -->
    <string name="ago_now">now</string>
    <string name="ago_minutes">%1$dm</string>
    <string name="ago_hours">%1$dh</string>

    <!-- Connection status in the header -->
    <string name="status_not_set_up">Not set up</string>
    <string name="status_in_sync">In sync</string>
    <string name="status_connecting">Connecting</string>
    <string name="status_token_rejected">Token rejected</string>
    <string name="status_busy">Server busy</string>
    <string name="status_offline">Offline</string>

    <!-- Connection status in the always-on notification -->
    <string name="service_offline">Offline, retrying</string>
    <string name="service_busy">Server busy, retrying later</string>
    <string name="service_token_rejected">Token rejected. Check Settings.</string>

    <!-- Settings -->
    <string name="server">Server</string>
    <string name="server_url">Server URL</string>
    <string name="plain_http_warning">Plain http sends your token unencrypted. Use https outside your home network.</string>
    <string name="token">Token</string>
    <string name="save_and_test">Save and test connection</string>
    <string name="testing">Testing</string>
    <string name="test_ok">Connected. Syncing now.</string>
    <string name="test_token_rejected">Server reached, but it rejected the token.</string>
    <string name="test_http_error">Server answered %1$d.</string>
    <string name="test_unreachable">Could not reach the server: %1$s</string>
    <string name="battery_explain">This phone may pause clrd in the background, and then clears from other devices arrive late.</string>
    <string name="battery_button">Let clrd run in the background</string>
    <string name="topics">Topics</string>
    <string name="topics_explain">A muted topic stays in the inbox but never pops up on this phone.</string>
    <string name="topic_muted">muted</string>
    <string name="topic_on">on</string>
    <string name="stack">Stack by topic</string>
    <string name="stack_show">Show all</string>
    <string name="stack_hide">Hide</string>
    <string name="stack_explain">Notifications from the same topic fold into one stack, in the app\'s list and in the phone\'s notification shade. Tap a stack in the list to open it. Swiping a notification or stack away only hides it on this phone; clear it in the app to clear it everywhere.</string>
    <string name="sound">Sound</string>
    <string name="sound_explain">What this phone plays for a new notification. Only this phone changes. Low priority notifications stay silent, and a muted topic never plays.</string>
    <string name="sound_preview">Play</string>
    <string name="sound_default">Phone default</string>
    <string name="sound_none">None (silent)</string>
    <string name="sound_chime">Chime</string>
    <string name="sound_ding">Ding</string>
    <string name="sound_pop">Pop</string>
    <string name="sound_bell">Bell</string>
    <string name="sound_alert">Alert</string>
    <string name="sound_soft">Soft</string>
    <string name="sound_overridden">This phone\'s own notification settings changed the sound or turned it down for clrd, so they win over the choice above.</string>
    <string name="sound_open_settings">Open notification settings</string>
    <string name="reply_sent_to_confirm">Your answer was sent for confirmation. It counts once an allowed device confirms it.</string>
    <string name="reply_approve_denied">Not answered: this phone may not answer approval requests. An allowed device can change that.</string>
    <string name="reply_own_request">Not answered: this request came from this phone\'s own token, so another device has to answer it.</string>
    <string name="reply_changed">Not answered: the question changed or was already answered.</string>
    <string name="approve_title">Approval requests</string>
    <string name="approve_allowed">This phone can answer approval requests.</string>
    <string name="approve_ask">This phone\'s answers to approval requests need an allowed device to confirm them.</string>
    <string name="approve_denied">This phone may not answer approval requests. An allowed device can change that.</string>
    <string name="dnd_explain">Urgent notifications (priority 5) are quiet in Do Not Disturb unless you let them through. Only you can turn that on, in Android\'s settings.</string>
    <string name="dnd_lost">Changing the sound turned off the Do Not Disturb pass for urgent ones. Android lets only you turn it back on, with the button below.</string>
    <string name="dnd_open">Let urgent ones through Do Not Disturb</string>
    <string name="signed_out">The server no longer accepts this phone. It was unlinked from another device, its token was revoked, or the token is wrong. Scan a new code or enter a token to sign in again.</string>
    <!-- Linked devices in Settings, the same list as the web Settings page. -->
    <string name="devices_title">Linked devices</string>
    <string name="device_this">%1$s (this phone)</string>
    <string name="kind_phone">phone</string>
    <string name="kind_browser">browser</string>
    <string name="kind_token">token</string>
    <string name="device_via">linked from %1$s</string>
    <string name="device_seen">seen %1$s</string>
    <string name="device_never_seen">never seen</string>
    <string name="device_unlink">Unlink</string>
    <string name="device_unlink_title">Unlink %1$s?</string>
    <string name="device_unlink_text">It is signed out at once and stops syncing. Unlinking a phone also signs out the browsers it approved. It can be linked again with a new code.</string>
    <string name="device_unlink_failed">Not unlinked: %1$s</string>
    <string name="device_log_show">Show activity</string>
    <string name="device_log_hide">Hide activity</string>
    <!-- A log line: how long ago, which device, what happened (linked, signed in, unlinked). -->
    <string name="device_log_line">%1$s  %2$s %3$s</string>
    <!-- After a log line: who did it. %1$s is a device name. -->
    <string name="device_log_by">by %1$s</string>
    <string name="sound_phone_only">Saved on this phone only: %1$s It is sent again on the next connect.</string>
    <string name="sound_no_connection">no connection.</string>
    <string name="sound_no_server">no server set up.</string>
    <!-- Group summary in the tray: how many notifications a topic's stack holds. -->
    <plurals name="tray_stack">
        <item quantity="one">%1$d notification</item>
        <item quantity="other">%1$d notifications</item>
    </plurals>
    <string name="about">clrd %1$s. No tracking, no Google services.</string>

    <!-- Android notification channels (shown in the system notification settings) -->
    <string name="channel_p1">Min priority</string>
    <string name="channel_p2">Low priority</string>
    <string name="channel_p3">Default priority</string>
    <string name="channel_p4">High priority</string>
    <string name="channel_p5">Urgent</string>
    <string name="channel_service">Sync connection</string>

    <!-- Notification tray -->
    <string name="tray_ack">Ack</string>
    <string name="tray_snooze">Snooze</string>
    <string name="tray_clear">Clear</string>
    <string name="tray_open">Open</string>
    <string name="tray_answered">Answered %1$s on %2$s</string>
    <string name="tray_acked">Acknowledged on %1$s</string>
    <string name="tray_another_device">another device</string>

    <!-- Signing in a browser from a clrd://pair link -->
    <string name="pair_title">Sign in a browser?</string>
    <string name="pair_text">%1$s wants to sign in to %2$s as this phone\'s account. Only approve if you just scanned the code on your own screen.</string>
    <string name="pair_approve">Approve</string>
    <string name="pair_deny">Deny</string>
    <string name="pair_done">Browser signed in</string>
    <string name="pair_expired">That code expired or was already used. Make a new one on the browser.</string>
    <string name="pair_other_server">This link is for a different server: %1$s</string>
    <string name="pair_not_set_up">Set up the app first: add your server and token in Settings, then scan the code again.</string>
    <string name="pair_bad_link">This sign-in link is not valid. Make a new one on the browser.</string>
    <string name="ok">OK</string>

    <!-- Linking this phone from a signed-in browser (QR code or clrd://link) -->
    <string name="scan_qr">Scan QR code</string>
    <string name="scan_prompt">Point at the code on your clrd Settings page</string>
    <string name="scan_not_clrd">Not a clrd code</string>
    <string name="link_title">Connect to %1$s?</string>
    <string name="link_text">Only say Yes if you just made this code on your own browser, signed in to that server. The browser then asks you to approve this phone.</string>
    <string name="link_replaces">This replaces the server this app uses now (%1$s) and clears its notifications from this phone.</string>
    <string name="link_yes">Yes</string>
    <string name="link_no">No</string>
    <string name="link_waiting_title">Approve on your computer</string>
    <string name="link_waiting_text">Your browser on %1$s now shows this phone. Approve it there only if it shows %2$s.</string>
    <string name="link_cancel">Cancel</string>
    <string name="link_done">Phone linked. Syncing now.</string>
    <string name="link_expired">That code expired, was denied or was already used. Make a new one on the browser.</string>
    <string name="snooze_settings">Snooze</string>
    <string name="snooze_explain">Snooze on a card uses the default time. Long press it for the other times. These settings apply to every device.</string>
    <string name="snooze_times">Times, comma separated (15m, 4h, 2d)</string>
    <string name="snooze_default">Default</string>
    <string name="snooze_save">Save snooze times</string>
    <string name="snooze_saved">Saved.</string>
